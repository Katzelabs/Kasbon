{
  // Copy this file to launch.json and replace the anon-key placeholder with the
  // value from `supabase status` (the publishable key). For a physical device,
  // duplicate one of the loopback entries and replace the host with your
  // machine's LAN IP, e.g. http://192.168.1.10:54321.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kasbon — Web (Chrome, local Supabase)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/kasbon-frontend",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--web-port=5000"],
      "toolArgs": [
        "--dart-define=SUPABASE_URL=http://127.0.0.1:54321",
        "--dart-define=SUPABASE_ANON_KEY=<your-local-publishable-key-from-supabase-status>"
      ]
    },
    {
      "name": "Kasbon — iOS Simulator (local Supabase)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/kasbon-frontend",
      "program": "lib/main.dart",
      "deviceId": "ios",
      "toolArgs": [
        "--dart-define=SUPABASE_URL=http://127.0.0.1:54321",
        "--dart-define=SUPABASE_ANON_KEY=<your-local-publishable-key-from-supabase-status>"
      ]
    },
    {
      "name": "Kasbon — Android Emulator (local Supabase)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/kasbon-frontend",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=SUPABASE_URL=http://10.0.2.2:54321",
        "--dart-define=SUPABASE_ANON_KEY=<your-local-publishable-key-from-supabase-status>"
      ]
    },
    {
      "name": "Kasbon — Android Emulator (profile)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/kasbon-frontend",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "toolArgs": [
        "--dart-define=SUPABASE_URL=http://10.0.2.2:54321",
        "--dart-define=SUPABASE_ANON_KEY=<your-local-publishable-key-from-supabase-status>"
      ]
    },
    {
      "name": "Kasbon — macOS Desktop (local Supabase)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/kasbon-frontend",
      "program": "lib/main.dart",
      "deviceId": "macos",
      "toolArgs": [
        "--dart-define=SUPABASE_URL=http://127.0.0.1:54321",
        "--dart-define=SUPABASE_ANON_KEY=<your-local-publishable-key-from-supabase-status>"
      ]
    }
  ]
}
