{
  // Copy this file to launch.json. Supabase URL/key are NOT set here — they come
  // from env files: copy app/env.example.json to app/env.json (loopback) and
  // app/env.android.json (SUPABASE_URL=http://10.0.2.2:54321 for the emulator),
  // filling in the publishable key from `supabase status`. For a physical
  // device, use your machine's LAN IP, e.g. http://192.168.1.10:54321.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kasbon — Web (Chrome, local Supabase)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--web-port=5000"],
      "toolArgs": ["--dart-define-from-file=env.json"]
    },
    {
      "name": "Kasbon — iOS Simulator (local Supabase)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "deviceId": "ios",
      "toolArgs": ["--dart-define-from-file=env.json"]
    },
    {
      "name": "Kasbon — Android Emulator (local Supabase)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define-from-file=env.android.json"]
    },
    {
      "name": "Kasbon — Android Emulator (profile)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "toolArgs": ["--dart-define-from-file=env.android.json"]
    },
    {
      "name": "Kasbon — macOS Desktop (local Supabase)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/app",
      "program": "lib/main.dart",
      "deviceId": "macos",
      "toolArgs": ["--dart-define-from-file=env.json"]
    }
  ]
}
