# VSCode launch config holds Supabase keys; only the .example is committed.
.vscode/launch.json

# Env files for --dart-define-from-file; only env.example.json is committed.
app/env.json
app/env.*.json
!app/env.example.json

# Signing keystores, anywhere in the tree. app/android/.gitignore already covers
# key.properties and the keystore globs under app/android/; this is the same rule
# one level up, for a .jks dropped somewhere else while setting up signing. An
# upload key cannot be rotated once an app is published under it, so committing
# one means losing the ability to ship updates.
*.jks
*.keystore

# Claude Code: personal permission overrides stay local; settings.json is shared.
.claude/settings.local.json

.DS_Store

# Python bytecode from the brand asset generator.
__pycache__/

# Flutter golden-test diff output, written on every failed comparison.
failures/

# Supabase CLI scratch state: the linked project ref, pooler URL and the
# version checks it caches. Per-developer and per-machine - `cli-latest` was
# tracked and turned up modified in every unrelated diff, and after `supabase
# link` this directory also names the production project.
supabase/.temp/
